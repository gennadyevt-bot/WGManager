<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D depth layer -->
    <item android:top="6dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FFB71C1C"
                android:endColor="#FF7F0000" />
        </shape>
    </item>
    <!-- Main surface -->
    <item android:bottom="6dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FFEF5350"
                android:endColor="#FFE53935" />
            <stroke
                android:width="2dp"
                android:color="#FFFFCDD2" />
        </shape>
    </item>
    <!-- Highlight -->
    <item
        android:left="20dp"
        android:right="20dp"
        android:top="10dp"
        android:bottom="80dp">
        <shape android:shape="oval">
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
